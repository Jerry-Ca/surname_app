# 复制为 .env 后填写真实值；.env 永不提交（见 .gitignore）
# 后端启动前必须存在，缺失时会以“降级模式”启动（结构化查询可用，智能问答不可用）

# ---------- 数据库 ----------
# 本地快速调试可用 SQLite；正式环境必须是 PostgreSQL（见 docs/architecture.md）
DATABASE_URL=postgresql+psycopg://surname:change_me@127.0.0.1:5432/surname_app
# DATABASE_URL=sqlite:///./dev.db

# ---------- 大模型（证据问答） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 向量化（可选，缺失时降级为全文检索） ----------
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# ---------- 服务 ----------
APP_ENV=local
API_PORT=8000
# 允许的前端来源；同源部署时留空
CORS_ORIGINS=